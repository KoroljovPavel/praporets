<?xml version="1.0" encoding="UTF-8"?>
<!-- порожній маркер робить jar «bean archive», і Quarkus додає його
     класи в Jandex-індекс. Без індексу native image не зареєструє
     protobuf-повідомлення для рефлексії (FieldAccessorTable всередині
     GeneratedMessage працює через java.lang.reflect). CDI-бінів тут немає
     і не буде — файл впливає лише на індексацію. -->
<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd"
       version="4.0" bean-discovery-mode="annotated">
</beans>
